<mxfile host="app.diagrams.net" agent="HourLink DACN" version="24.0">
  <diagram id="sequence-ai-matching" name="Hình 2.9 - Biểu đồ tuần tự AI Matching">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Biểu đồ tuần tự — AI Matching (Gợi ý ghép cặp bằng AI)" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="250" y="10" width="800" height="30" as="geometry" />
        </mxCell>

        <!-- ===== LIFELINES ===== -->
        <!-- User -->
        <mxCell id="ll_user" value="Người dùng" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;size=40;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="120" height="800" as="geometry" />
        </mxCell>
        <!-- FE -->
        <mxCell id="ll_fe" value="Mobile App&#xa;(React Native)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;size=40;" vertex="1" parent="1">
          <mxGeometry x="260" y="50" width="130" height="800" as="geometry" />
        </mxCell>
        <!-- BE Controller -->
        <mxCell id="ll_ctrl" value="AiMatchingController" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;size=40;" vertex="1" parent="1">
          <mxGeometry x="460" y="50" width="140" height="800" as="geometry" />
        </mxCell>
        <!-- BE Service -->
        <mxCell id="ll_svc" value="AiMatchingService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;size=40;" vertex="1" parent="1">
          <mxGeometry x="660" y="50" width="140" height="800" as="geometry" />
        </mxCell>
        <!-- Repository -->
        <mxCell id="ll_repo" value="Repository&#xa;(JPA)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=11;size=40;" vertex="1" parent="1">
          <mxGeometry x="860" y="50" width="120" height="800" as="geometry" />
        </mxCell>
        <!-- Gemini AI -->
        <mxCell id="ll_ai" value="Gemini AI&#xa;(Google)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;size=40;" vertex="1" parent="1">
          <mxGeometry x="1060" y="50" width="120" height="800" as="geometry" />
        </mxCell>

        <!-- ===== MESSAGES ===== -->
        <!-- 1. User → FE: Bấm gợi ý -->
        <mxCell id="m1" value="1. Bấm &quot;Gợi ý AI&quot; trên HelpRequest" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="120" y="140" as="sourcePoint" />
            <mxPoint x="325" y="140" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 2. FE → Controller: POST /ai-matching/suggest -->
        <mxCell id="m2" value="2. POST /ai-matching/suggest {helpRequestId}" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="325" y="190" as="sourcePoint" />
            <mxPoint x="530" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 3. Controller → Service: suggest(helpRequestId) -->
        <mxCell id="m3" value="3. suggest(helpRequestId)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="240" as="sourcePoint" />
            <mxPoint x="730" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 4. Service → Repository: findById(helpRequestId) -->
        <mxCell id="m4" value="4. findById(helpRequestId)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="290" as="sourcePoint" />
            <mxPoint x="920" y="290" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 4b. Repository → Service: return HelpRequest -->
        <mxCell id="m4b" value="HelpRequest" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="320" as="sourcePoint" />
            <mxPoint x="730" y="320" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 5. Service → Repository: findMatchingSkills() -->
        <mxCell id="m5" value="5. findSkillsByCategory(category, format, region)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="370" as="sourcePoint" />
            <mxPoint x="920" y="370" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 5b. Repository → Service: return List<Skill> -->
        <mxCell id="m5b" value="List&lt;Skill&gt; + User info" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="920" y="400" as="sourcePoint" />
            <mxPoint x="730" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 6. Service → Gemini: Gửi prompt -->
        <mxCell id="m6" value="6. generateContent(prompt)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;strokeColor=#9673a6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="460" as="sourcePoint" />
            <mxPoint x="1120" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Note: prompt content -->
        <mxCell id="note1" value="Prompt bao gồm:&#xa;- Thông tin HelpRequest (title, description, level)&#xa;- Danh sách ứng viên (skill, reputation, region)&#xa;- Yêu cầu trả về JSON với matchScore + reason" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF9C4;fontSize=10;align=left;spacingLeft=6;size=14;" vertex="1" parent="1">
          <mxGeometry x="780" y="480" width="280" height="80" as="geometry" />
        </mxCell>

        <!-- 6b. Gemini → Service: return JSON -->
        <mxCell id="m6b" value="JSON [{userId, matchScore, reason}, ...]" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;strokeColor=#9673a6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1120" y="580" as="sourcePoint" />
            <mxPoint x="730" y="580" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 7. Service → Service: parse JSON -->
        <mxCell id="m7" value="7. parseAiResponse()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;curved=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="620" as="sourcePoint" />
            <mxPoint x="730" y="650" as="targetPoint" />
            <Array as="points">
              <mxPoint x="780" y="635" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 8. Service → Controller: return List<MatchResult> -->
        <mxCell id="m8" value="8. List&lt;MatchResult&gt;" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="680" as="sourcePoint" />
            <mxPoint x="530" y="680" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 9. Controller → FE: 200 OK ApiResponse -->
        <mxCell id="m9" value="9. 200 OK AiMatchingResponse" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="530" y="720" as="sourcePoint" />
            <mxPoint x="325" y="720" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 10. FE → User: Hiển thị danh sách -->
        <mxCell id="m10" value="10. Hiển thị danh sách gợi ý (tên, matchScore%, reason)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="325" y="760" as="sourcePoint" />
            <mxPoint x="120" y="760" as="targetPoint" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
