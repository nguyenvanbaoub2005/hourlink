<mxfile host="app.diagrams.net" agent="HourLink DACN" version="24.0">
  <diagram id="state-appointment" name="Hình 2.7 - Biểu đồ trạng thái lịch hẹn (Appointment)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Biểu đồ trạng thái — Appointment (Lịch hẹn)" style="text;html=1;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- Initial state -->
        <mxCell id="init" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- States -->
        <mxCell id="s_pending" value="PENDING&#xa;(Chờ xác nhận)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="100" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s_confirmed" value="CONFIRMED&#xa;(Đã xác nhận)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="100" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s_upcoming" value="UPCOMING&#xa;(Sắp diễn ra)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="100" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s_inprogress" value="IN_PROGRESS&#xa;(Đang diễn ra)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="280" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s_completed" value="COMPLETED&#xa;(Đã hoàn thành)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="460" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s_cancelled" value="CANCELLED&#xa;(Đã hủy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="460" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s_rescheduled" value="RESCHEDULED&#xa;(Đề xuất đổi lịch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="280" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s_disputed" value="DISPUTED&#xa;(Tranh chấp)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="460" width="170" height="60" as="geometry" />
        </mxCell>

        <!-- Final state -->
        <mxCell id="final1" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="770" y="580" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="final2" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="240" y="580" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Transitions -->
        <!-- init → PENDING -->
        <mxCell id="t0" value="Tạo lịch hẹn" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;fontStyle=2;" edge="1" source="init" target="s_pending" parent="1" />

        <!-- PENDING → CONFIRMED -->
        <mxCell id="t1" value="Receiver xác nhận" style="fontSize=10;fontStyle=2;" edge="1" source="s_pending" target="s_confirmed" parent="1" />

        <!-- PENDING → CANCELLED -->
        <mxCell id="t2" value="Hủy / Từ chối" style="fontSize=10;fontStyle=2;fontColor=#EF4444;" edge="1" source="s_pending" target="s_cancelled" parent="1" />

        <!-- PENDING → RESCHEDULED -->
        <mxCell id="t3" value="Đề xuất đổi lịch" style="fontSize=10;fontStyle=2;fontColor=#9673a6;" edge="1" source="s_pending" target="s_rescheduled" parent="1" />

        <!-- RESCHEDULED → CONFIRMED -->
        <mxCell id="t4" value="Chấp nhận&#xa;lịch mới" style="fontSize=10;fontStyle=2;" edge="1" source="s_rescheduled" target="s_confirmed" parent="1" />

        <!-- RESCHEDULED → CANCELLED -->
        <mxCell id="t5" value="Từ chối" style="fontSize=10;fontStyle=2;fontColor=#EF4444;" edge="1" source="s_rescheduled" target="s_cancelled" parent="1" />

        <!-- CONFIRMED → UPCOMING -->
        <mxCell id="t6" value="Gần đến ngày hẹn" style="fontSize=10;fontStyle=2;" edge="1" source="s_confirmed" target="s_upcoming" parent="1" />

        <!-- CONFIRMED → CANCELLED -->
        <mxCell id="t7" value="Hủy lịch" style="fontSize=10;fontStyle=2;fontColor=#EF4444;" edge="1" source="s_confirmed" target="s_cancelled" parent="1" />

        <!-- CONFIRMED → RESCHEDULED -->
        <mxCell id="t7b" value="Đổi lịch" style="fontSize=10;fontStyle=2;fontColor=#9673a6;" edge="1" source="s_confirmed" target="s_rescheduled" parent="1" />

        <!-- UPCOMING → IN_PROGRESS -->
        <mxCell id="t8" value="Check-in QR/OTP&#xa;thành công" style="fontSize=10;fontStyle=2;fontColor=#10B981;" edge="1" source="s_upcoming" target="s_inprogress" parent="1" />

        <!-- UPCOMING → CANCELLED -->
        <mxCell id="t8b" value="Hủy" style="fontSize=10;fontStyle=2;fontColor=#EF4444;" edge="1" source="s_upcoming" target="s_cancelled" parent="1" />

        <!-- IN_PROGRESS → COMPLETED -->
        <mxCell id="t9" value="Cả 2 bên xác nhận&#xa;hoàn thành&#xa;→ Chuyển Time Credit" style="fontSize=10;fontStyle=2;fontColor=#10B981;" edge="1" source="s_inprogress" target="s_completed" parent="1" />

        <!-- IN_PROGRESS → DISPUTED -->
        <mxCell id="t10" value="Mở tranh chấp" style="fontSize=10;fontStyle=2;fontColor=#EF4444;" edge="1" source="s_inprogress" target="s_disputed" parent="1" />

        <!-- DISPUTED → COMPLETED -->
        <mxCell id="t11" value="Admin xử lý&#xa;→ Hoàn thành" style="fontSize=10;fontStyle=2;" edge="1" source="s_disputed" target="s_completed" parent="1" />

        <!-- DISPUTED → CANCELLED -->
        <mxCell id="t12" value="Admin xử lý&#xa;→ Hủy" style="fontSize=10;fontStyle=2;fontColor=#EF4444;" edge="1" source="s_disputed" target="s_cancelled" parent="1" />

        <!-- COMPLETED → final -->
        <mxCell id="t13" style="" edge="1" source="s_completed" target="final1" parent="1" />

        <!-- CANCELLED → final -->
        <mxCell id="t14" style="" edge="1" source="s_cancelled" target="final2" parent="1" />

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
