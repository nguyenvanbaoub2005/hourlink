<mxfile host="app.diagrams.net" agent="HourLink DACN" version="24.0">
  <diagram id="activity-appointment-tc" name="Hình 2.6 - Biểu đồ hoạt động tạo lịch và chuyển Time Credit">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- SWIMLANES -->
        <mxCell id="sw_p" value="Người hỗ trợ (Provider)" style="shape=swimlane;startSize=30;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1250" height="200" as="geometry" />
        </mxCell>
        <mxCell id="sw_r" value="Người nhận hỗ trợ (Receiver)" style="shape=swimlane;startSize=30;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="220" width="1250" height="200" as="geometry" />
        </mxCell>
        <mxCell id="sw_be" value="Server Backend (BE)" style="shape=swimlane;startSize=30;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="420" width="1250" height="280" as="geometry" />
        </mxCell>
        <mxCell id="sw_wallet" value="Wallet Service" style="shape=swimlane;startSize=30;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="700" width="1250" height="220" as="geometry" />
        </mxCell>
        <mxCell id="sw_db" value="Cơ sở dữ liệu" style="shape=swimlane;startSize=30;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;fontColor=#333333;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="920" width="1250" height="130" as="geometry" />
        </mxCell>

        <!-- PROVIDER LANE (y:20-220) -->
        <mxCell id="n_start" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="75" y="100" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p_create" value="Bấm &quot;Tạo lịch hẹn&quot;&#xa;trong Chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="145" y="90" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p_fill" value="Nhập: Tiêu đề, Ngày, Giờ,&#xa;Hình thức, Địa điểm/Link,&#xa;Time Credit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="80" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p_confirm" value="Xác nhận hoàn thành&#xa;buổi hỗ trợ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="90" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p_done" value="Nhận thông báo&#xa;TC đã chuyển thành công" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="90" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n_end" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1253" y="100" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- RECEIVER LANE (y:220-420) -->
        <mxCell id="r_notif" value="Nhận thông báo&#xa;lịch hẹn mới" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="285" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r_check" value="Xác nhận?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="278" width="110" height="65" as="geometry" />
        </mxCell>
        <mxCell id="r_accept" value="Bấm &quot;Xác nhận&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="945" y="278" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r_reject" value="Từ chối&#xa;(Lịch bị hủy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="370" width="130" height="45" as="geometry" />
        </mxCell>
        <mxCell id="r_confirm_done" value="Xác nhận hoàn thành&#xa;buổi hỗ trợ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="258" width="1" height="1" as="geometry" />
        </mxCell>

        <!-- BE LANE (y:420-700) -->
        <mxCell id="b_create_appt" value="Tạo Appointment&#xa;status = PENDING&#xa;Gửi notification cho Receiver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="460" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_confirm_appt" value="Cập nhật status&#xa;→ CONFIRMED&#xa;Gửi card lịch vào Chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="460" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_checkin" value="Check-in xác thực&#xa;(QR Code / OTP)&#xa;→ IN_PROGRESS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="460" width="170" height="65" as="geometry" />
        </mxCell>
        <mxCell id="b_completed" value="Cả 2 bên confirm&#xa;→ status = COMPLETED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1030" y="460" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b_update_sessions" value="completedSessions += 1&#xa;cho cả 2 người dùng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1030" y="570" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- WALLET LANE (y:700-920) -->
        <mxCell id="w_check" value="Kiểm tra số dư ví&#xa;Receiver ≥ timeCreditAmount?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="758" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w_bal_ok" value="Đủ&#xa;số dư?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="575" y="760" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w_transfer" value="Trừ TC ví Receiver&#xa;Cộng TC ví Provider&#xa;Tạo 2 WalletTransaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="755" width="200" height="65" as="geometry" />
        </mxCell>
        <mxCell id="w_fail" value="Lỗi: Không đủ&#xa;Time Credit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="575" y="850" width="150" height="45" as="geometry" />
        </mxCell>
        <mxCell id="w_done" value="Gửi notification&#xa;TC đã chuyển thành công" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="760" width="190" height="50" as="geometry" />
        </mxCell>

        <!-- DB LANE (y:920-1050) -->
        <mxCell id="db_ops" value="INSERT appointment;&#xa;UPDATE wallet (x2);&#xa;INSERT wallet_transaction (x2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="958" width="230" height="55" as="geometry" />
        </mxCell>

        <!-- ===== EDGES ===== -->
        <!-- Provider flow -->
        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="n_start" target="p_create" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p_create" target="p_fill" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Provider → BE tạo lịch -->
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p_fill" target="b_create_appt" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- BE gửi thông báo cho Receiver -->
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="b_create_appt" target="r_notif" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Receiver quyết định -->
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r_notif" target="r_check" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5_ok" value="Có" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;fontStyle=1;fontColor=#10B981;" edge="1" source="r_check" target="r_accept" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5_no" value="Không" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;fontStyle=1;fontColor=#EF4444;" edge="1" source="r_check" target="r_reject" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Receiver xác nhận → BE confirm -->
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="r_accept" target="b_confirm_appt" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Check-in & hoàn thành -->
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="b_confirm_appt" target="b_checkin" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Cả 2 bên xác nhận hoàn thành -->
        <mxCell id="e8_p" value="Provider xác nhận" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;dashed=1;" edge="1" source="p_confirm" target="b_completed" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8_r" value="Receiver xác nhận" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;dashed=1;" edge="1" source="b_checkin" target="b_completed" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- BE → WalletService -->
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="b_completed" target="w_check" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="w_check" target="w_bal_ok" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11_ok" value="Đủ" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;fontStyle=1;fontColor=#10B981;" edge="1" source="w_bal_ok" target="w_transfer" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11_fail" value="Thiếu" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;fontStyle=1;fontColor=#EF4444;" edge="1" source="w_bal_ok" target="w_fail" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- DB operations -->
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="w_transfer" target="db_ops" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="db_ops" target="w_done" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Hoàn thành update sessions -->
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="w_done" target="b_update_sessions" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Thông báo về Provider và end -->
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="b_update_sessions" target="p_done" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p_done" target="n_end" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

