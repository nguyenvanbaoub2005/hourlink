# frozen_string_literal: true

default_platform(:android)

platform :android do
  desc "Chạy kiểm tra static typecheck TypeScript"
  lane :check do
    UI.header("🔍 Kiểm tra mã nguồn HourLink...")
    Dir.chdir("..") do
      sh("npm run typecheck")
    end
    UI.success("✅ Kiểm tra kiểu dữ liệu TypeScript thành công!")
  end

  desc "Chuẩn bị native project (Expo CNG Prebuild) và cấu hình Keystore ký số"
  lane :prepare_native do
    UI.header("🛠️ Khởi tạo dự án Android từ Expo Config (CNG)...")

    # 1. Chạy prebuild nếu chưa có thư mục android
    unless File.directory?("../android")
      UI.message("Chưa tìm thấy thư mục native android/, tiến hành chạy expo prebuild...")
      Dir.chdir("..") do
        sh("npx expo prebuild --platform android --clean --no-install")
      end
    else
      UI.message("Thư mục native android/ đã tồn tại.")
    end

    # Cấp quyền thực thi cho gradlew trên Linux/macOS
    gradlew_path = File.expand_path("../android/gradlew", __dir__)
    if File.exist?(gradlew_path) && !Gem.win_platform?
      File.chmod(0755, gradlew_path)
    end

    # 2. Đảm bảo thư mục dist/ tồn tại
    FileUtils.mkdir_p(File.expand_path("../dist", __dir__))

    # 3. Xác định Keystore ký số
    app_dir = File.expand_path("../android/app", __dir__)
    FileUtils.mkdir_p(app_dir)
    keystore_path = File.join(app_dir, "release.keystore")

    get_env = lambda do |key, default|
      val = ENV[key]
      (val.nil? || val.strip.empty?) ? default : val.strip
    end

    keystore_password = get_env.call("ANDROID_KEYSTORE_PASSWORD", get_env.call("KEYSTORE_PASSWORD", "hourlink123"))
    key_alias = get_env.call("ANDROID_KEY_ALIAS", get_env.call("KEY_ALIAS", "hourlink"))
    key_password = get_env.call("ANDROID_KEY_PASSWORD", get_env.call("KEY_PASSWORD", "hourlink123"))

    # Giải mã Keystore từ biến môi trường nếu có
    if ENV["ANDROID_KEYSTORE_BASE64"] && !ENV["ANDROID_KEYSTORE_BASE64"].strip.empty?
      UI.message("🔓 Giải mã Keystore từ biến môi trường ANDROID_KEYSTORE_BASE64...")
      require "base64"
      File.binwrite(keystore_path, Base64.decode64(ENV["ANDROID_KEYSTORE_BASE64"].strip))
      UI.success("Đã ghi Keystore thành công vào: #{keystore_path}")
    elsif !File.exist?(keystore_path)
      # Tự động tạo Release Keystore RSA 2048-bit nếu chưa có
      UI.message("⚠️ Tự động tạo Release Keystore mới để ký số tự động...")
      sh("keytool -genkey -v -keystore \"#{keystore_path}\" -alias \"#{key_alias}\" -keyalg RSA -keysize 2048 -validity 10000 -storepass \"#{keystore_password}\" -keypass \"#{key_password}\" -dname \"CN=HourLink, OU=Mobile, O=HourLink Team, L=Hanoi, ST=Hanoi, C=VN\" -noprompt")
      UI.success("Đã khởi tạo Keystore ký số thành công: #{keystore_path}")
    end

    # 4. Ghi thông số ký số vào gradle.properties theo chuẩn React Native
    gradle_props_path = File.expand_path("../android/gradle.properties", __dir__)
    if File.exist?(gradle_props_path)
      props_content = File.read(gradle_props_path)
      unless props_content.include?("HOURLINK_RELEASE_STORE_FILE")
        release_props = <<~PROPS

          # --- HourLink Release Signing Config ---
          HOURLINK_RELEASE_STORE_FILE=release.keystore
          HOURLINK_RELEASE_KEY_ALIAS=#{key_alias}
          HOURLINK_RELEASE_STORE_PASSWORD=#{keystore_password}
          HOURLINK_RELEASE_KEY_PASSWORD=#{key_password}
        PROPS
        File.open(gradle_props_path, "a") { |f| f.write(release_props) }
        UI.success("Đã cập nhật gradle.properties với thông tin ký số release!")
      end
    end

    # 5. Cấu hình signingConfig release trong android/app/build.gradle
    build_gradle_path = File.join(app_dir, "build.gradle")
    if File.exist?(build_gradle_path)
      gradle_content = File.read(build_gradle_path).gsub(/\r\n/, "\n")
      unless gradle_content.include?("signingConfigs.release")
        release_signing_block = <<~GRADLE
              release {
                  if (project.hasProperty('HOURLINK_RELEASE_STORE_FILE')) {
                      storeFile file(HOURLINK_RELEASE_STORE_FILE)
                      storePassword HOURLINK_RELEASE_STORE_PASSWORD
                      keyAlias HOURLINK_RELEASE_KEY_ALIAS
                      keyPassword HOURLINK_RELEASE_KEY_PASSWORD
                  } else {
                      storeFile file('release.keystore')
                      storePassword '#{keystore_password}'
                      keyAlias '#{key_alias}'
                      keyPassword '#{key_password}'
                  }
              }
        GRADLE

        # Chèn block release { ... } ngay sau "signingConfigs {"
        if gradle_content.include?("signingConfigs {")
          gradle_content = gradle_content.sub("signingConfigs {", "signingConfigs {\n#{release_signing_block.rstrip}")
        end

        # Chuyển release buildType từ signingConfigs.debug sang signingConfigs.release
        debug_sign_target = "// Caution! In production, you need to generate your own keystore file.\n            // see https://reactnative.dev/docs/signed-apk-android.\n            signingConfig signingConfigs.debug"
        if gradle_content.include?(debug_sign_target)
          gradle_content = gradle_content.sub(debug_sign_target, "signingConfig signingConfigs.release")
        else
          parts = gradle_content.split("signingConfig signingConfigs.debug", 3)
          if parts.length >= 3
            gradle_content = "#{parts[0]}signingConfig signingConfigs.debug#{parts[1]}signingConfig signingConfigs.release#{parts[2]}"
          end
        end

        File.write(build_gradle_path, gradle_content)
        UI.success("Đã cấu hình signingConfig release thành công trong build.gradle!")
      end
    end

    # Lưu context cho các bước sau
    Actions.lane_context[:keystore_path] = keystore_path
  end

  desc "Tự động đóng gói và ký số APK Release (Phát hành thử nghiệm / Cài trực tiếp)"
  lane :build_apk do
    UI.header("📦 Bắt đầu quy trình đóng gói Release APK (Ký số tự động qua Fastlane)...")

    # Chuẩn bị native & keystore
    prepare_native

    # Biên dịch qua Gradle
    gradle(
      task: "assembleRelease",
      project_dir: "../android/",
      print_command: true
    )

    # Tìm file APK đầu ra
    apk_candidates = Dir.glob("../android/app/build/outputs/apk/release/*.apk").reject { |f| f.include?("unaligned") }
    if apk_candidates.empty?
      UI.user_error!("❌ Không tìm thấy file APK sau khi biên dịch!")
    end

    source_apk = apk_candidates.first
    target_apk = File.expand_path("../dist/hourlink-release.apk", __dir__)
    FileUtils.cp(source_apk, target_apk)

    # Tính toán SHA256 để nghiệm thu chất lượng
    require "digest"
    sha256 = Digest::SHA256.file(target_apk).hexdigest
    file_size_mb = (File.size(target_apk).to_f / (1024 * 1024)).round(2)

    UI.success("🎉 ĐÓNG GÓI RELEASE APK THÀNH CÔNG QUA FASTLANE!")
    UI.message("📍 Vị trí APK: #{target_apk}")
    UI.message("📏 Kích thước: #{file_size_mb} MB")
    UI.message("🔑 SHA-256 Checksum: #{sha256}")
  end

  desc "Tự động đóng gói và ký số Android App Bundle (AAB Release cho Google Play Store)"
  lane :build_aab do
    UI.header("📦 Bắt đầu quy trình đóng gói Release AAB (Google Play Store qua Fastlane)...")

    # Chuẩn bị native & keystore
    prepare_native

    # Biên dịch qua Gradle
    gradle(
      task: "bundleRelease",
      project_dir: "../android/",
      print_command: true
    )

    # Tìm file AAB đầu ra
    aab_candidates = Dir.glob("../android/app/build/outputs/bundle/release/*.aab")
    if aab_candidates.empty?
      UI.user_error!("❌ Không tìm thấy file AAB sau khi biên dịch!")
    end

    source_aab = aab_candidates.first
    target_aab = File.expand_path("../dist/hourlink-release.aab", __dir__)
    FileUtils.cp(source_aab, target_aab)

    # Tính toán SHA256
    require "digest"
    sha256 = Digest::SHA256.file(target_aab).hexdigest
    file_size_mb = (File.size(target_aab).to_f / (1024 * 1024)).round(2)

    UI.success("🎉 ĐÓNG GÓI RELEASE AAB THÀNH CÔNG QUA FASTLANE!")
    UI.message("📍 Vị trí AAB: #{target_aab}")
    UI.message("📏 Kích thước: #{file_size_mb} MB")
    UI.message("🔑 SHA-256 Checksum: #{sha256}")
  end

  desc "Dọn dẹp các thư mục build tạm"
  lane :clean do
    UI.message("🧹 Dọn dẹp thư mục build tạm...")
    if File.directory?("../android")
      gradle(task: "clean", project_dir: "../android/")
    end
    FileUtils.rm_rf(File.expand_path("../dist", __dir__))
    UI.success("Dọn dẹp hoàn tất!")
  end
end
