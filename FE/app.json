{
  "expo": {
    "name": "HourLink",
    "slug": "hourlink",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "hourlink",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.hourlink.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "package": "vn.hourlink.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6366F1"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "HourLink cần truy cập camera để quét mã QR xác nhận buổi học."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HourLink cần truy cập thư viện ảnh để cập nhật ảnh đại diện và gửi minh chứng hoạt động."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "HourLink cần truy cập vị trí để bạn chia sẻ địa điểm gặp mặt trong cuộc trò chuyện."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
